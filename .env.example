# Copy to .env (not tracked by git); docker compose reads it automatically.
# Empty value = default.

# Flask session key, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Host port (default: 8485)
CA_PORT=8485

# Default subject fields on the new root CA form (others are taken from the issuing CA)
DEFAULT_C=
DEFAULT_ST=
DEFAULT_L=
DEFAULT_O=

# Time zone, used for the notification time, e.g. Europe/Budapest (default: UTC)
TZ=UTC

# --- Expiry notifications (daily digest; disabled if no URL is set) ---
NOTIFY_DAYS=30
NOTIFY_HOUR=8
# Slack/Discord/Mattermost/Home Assistant, e.g. https://hooks.slack.com/services/...
NOTIFY_WEBHOOK_URL=
# e.g. https://ntfy.sh/my-secret-topic
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
# Public URL of the app, linked in notifications, e.g. https://ca.home.arpa
PUBLIC_URL=

# --- Audit: user name header(s) sent by the reverse proxy, comma-separated ---
# Empty: X-Forwarded-User,X-Forwarded-Preferred-Username,X-Auth-Request-User,Remote-User,X-Remote-User
AUDIT_USER_HEADER=
