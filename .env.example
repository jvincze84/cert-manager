# Másold .env néven (a .env nincs a gitben), a docker compose automatikusan beolvassa.
# Copy to .env (not tracked by git); docker compose reads it automatically.
# Üres érték = alapértelmezés. / Empty value = default.

# Session kulcs, pl.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Host port (alap: 8485)
CA_PORT=8485

# Alapértelmezett DN mezők az új Root CA űrlapon (a többi a kiállító CA-ból jön)
# Default subject fields on the new root CA form
DEFAULT_C=
DEFAULT_ST=
DEFAULT_L=
DEFAULT_O=

# Időzóna (az értesítés idejéhez), pl. Europe/Budapest (alap: UTC)
TZ=UTC

# --- Lejárati értesítések (napi összesítő; ha egyik URL sincs megadva, nem küld) ---
# --- Expiry notifications (daily digest; disabled if no URL is set) ---
NOTIFY_DAYS=30
NOTIFY_HOUR=8
# Slack/Discord/Mattermost/Home Assistant, pl. https://hooks.slack.com/services/...
NOTIFY_WEBHOOK_URL=
# pl. https://ntfy.sh/sajat-titkos-topic
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
# Az app címe, link az értesítésben, pl. https://ca.home.arpa
PUBLIC_URL=

# --- Audit: a reverse proxy által küldött felhasználónév fejléc(ek), vesszővel ---
# Üresen: X-Forwarded-User,X-Forwarded-Preferred-Username,X-Auth-Request-User,Remote-User,X-Remote-User
AUDIT_USER_HEADER=
